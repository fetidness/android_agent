# ---- build artifacts (mari, regenerabile) ----
workspace/build/
workspace/poc/
workspace/app/pydist/

# ---- tarballs / binare mari ----
*.tar
*.tar.gz
*.tgz
*.deb
*.xwd
*.apk
*.so
*.a

# ---- screenshot-uri de test ----
workspace/*.png
workspace/shot*.xwd
workspace/smoke/

# ---- scripturi de test temporare ----
workspace/t[0-9].py
workspace/tb*.py
workspace/test_*.py

# ---- loguri si fisiere temporare ----
workspace/logs/
workspace/*.txt
workspace/*.log
__pycache__/
*.pyc
.gradle/
build/
local.properties

# ---- context/arhive (volatile) ----
workspace/context.json
workspace/archive/

# ---- stdlib CPython din assets (regenerabil din sursa PSF) ----
workspace/app/net.sys32.agent/app/src/main/assets/python/Lib/*
# libdynload: COMIS (module .so critice: _ssl/_socket/zlib/_sqlite3/_ctypes - nu se regenereaza usor)
# excludem doar testele CPython, inutile la runtime
workspace/app/net.sys32.agent/app/src/main/assets/python/libdynload/**/_test*
!workspace/app/net.sys32.agent/app/src/main/assets/python/libdynload/arm64/*.so
# pastram site-packages: sunt biblioteci externe descarcate de pe PyPI, NU regenerabile din sursa CPython
!workspace/app/net.sys32.agent/app/src/main/assets/python/Lib/site-packages/
!workspace/app/net.sys32.agent/app/src/main/assets/python/Lib/zipfile/

# ---- gradle wrapper jar + binare wrapper ----
workspace/app/net.sys32.agent/gradle/wrapper/gradle-wrapper.jar
workspace/app/net.sys32.agent/gradlew
workspace/app/net.sys32.agent/gradlew.bat

# dump-uri de analiza locale (conversatii extrase de pe device)
workspace/samsung_dump/
# fisiere temporare de test
temp/

# chei API - NU se urca niciodata
key.txt
**/key.txt
.deepseek_agent_key

# backups locale (nu intra in repo)
*.bak
*.bak-*
*.bak.*

# ---- logul auto-learn (artefact de rulare) ----
auto_learn.log

# ---- memorie agent (locala, nu se urca in git) ----
memory.md

# ---- toolchain nativ (257 MB, regenerabil cu build_toolchain.sh) ----
workspace/app/net.sys32.agent/app/src/main/assets/toolchain/
workspace/app/net.sys32.agent/app/src/main/jniLibs/arm64-v8a/lib*_exec.so
workspace/app/net.sys32.agent/.kotlin/
workspace/app/net.sys32.agent/.gradle/
app/build/

# ---- assets de BUILD ale agentului principal (JDK/Gradle/SDK, ~381 MB) ----
# se copiaza din APK-ul agentului sau din /data/local/tmp/apkbuild
workspace/app/net.sys32.agent/app/src/main/assets/android_build/

# backup-uri locale (generate de agent la editari)
*.bak_*

# ---- ledger de consum (date de runtime, se scrie la fiecare runda) ----
insights.json

# backup local al documentelor inainte de consolidare (2026-10-22)
.docs_backup/

# memory.md livrat in APK (sursa de adevar pt lectiile la instalare curata)
!workspace/app/net.sys32.agent/app/src/main/assets/memory.md

# EXCEPTIE (out-of-the-box): modulele native .so din pachetele livrate in assets
# fara ele scraper (lxml/etree) si quickjs NU functioneaza dupa rebuild APK
!workspace/app/net.sys32.agent/app/src/main/assets/python/Lib/site-packages/**/*.so
!workspace/app/net.sys32.agent/app/src/main/assets/python/libdynload/**/*.so

# ---- Phonon TTS (voce offline): cele 2 binare TREBUIE comise, altfel build-ul nu are
# ce livra dupa o clona noua. Modelul (63 MB) NU se comite: se pune din Hugging Face
# (vezi readme.md -> "Voce offline (Phonon)"), iar aplicatia il extrage din assets.
!workspace/app/net.sys32.agent/app/src/main/jniLibs/arm64-v8a/libptts_ffi.so
!workspace/app/net.sys32.agent/app/src/main/jniLibs/arm64-v8a/libptts_exec.so
workspace/app/net.sys32.agent/app/src/main/assets/models/
workspace/app/net.sys32.agent/app/.cxx/

# ---- modele whisper (1.5 GB, se descarca la build cu fetch_whisper.sh) ----
workspace/app/net.sys32.agent/app/src/main/assets/whisper/models/
