# ---- build artifacts (mari, regenerabile) ----
workspace/build/
workspace/poc/
workspace/app/pydist/

# ---- tarballs / binare mari ----
*.tar
*.tar.gz
*.tgz
*.deb
*.xwd
*.apk
*.so
*.a

# ---- screenshot-uri de test ----
workspace/*.png
workspace/shot*.xwd
workspace/smoke/

# ---- scripturi de test temporare ----
workspace/t[0-9].py
workspace/tb*.py
workspace/test_*.py

# ---- loguri si fisiere temporare ----
workspace/logs/
workspace/*.txt
workspace/*.log
__pycache__/
*.pyc
.gradle/
build/
local.properties

# ---- context/arhive (volatile) ----
workspace/context.json
workspace/archive/

# ---- stdlib CPython din assets (regenerabil din sursa PSF) ----
workspace/app/net.sys32.agent/app/src/main/assets/python/Lib/*
workspace/app/net.sys32.agent/app/src/main/assets/python/libdynload/
# pastram site-packages: sunt biblioteci externe descarcate de pe PyPI, NU regenerabile din sursa CPython
!workspace/app/net.sys32.agent/app/src/main/assets/python/Lib/site-packages/
!workspace/app/net.sys32.agent/app/src/main/assets/python/Lib/zipfile/
workspace/app/net.sys32.agent/app/src/main/assets/python/libdynload/

# ---- gradle wrapper jar + binare wrapper ----
workspace/app/net.sys32.agent/gradle/wrapper/gradle-wrapper.jar
workspace/app/net.sys32.agent/gradlew
workspace/app/net.sys32.agent/gradlew.bat

# dump-uri de analiza locale (conversatii extrase de pe device)
workspace/samsung_dump/
# fisiere temporare de test
temp/

# chei API - NU se urca niciodata
key.txt
**/key.txt
.deepseek_agent_key

# backups locale (nu intra in repo)
*.bak
*.bak-*
*.bak.*

# ---- logul auto-learn (artefact de rulare) ----
auto_learn.log

# ---- memorie agent (locala, nu se urca in git) ----
memory.md
# EXCEPTIE: memoria partajata in odc_agent (cerut explicit, utila pt reproducere)
!odc_agent/memory.md

# ---- toolchain nativ (257 MB, regenerabil cu build_toolchain.sh) ----
workspace/app/net.sys32.agent/app/src/main/assets/toolchain/
workspace/app/net.sys32.agent/app/src/main/jniLibs/arm64-v8a/lib*_exec.so
workspace/app/net.sys32.agent/.kotlin/
workspace/app/net.sys32.agent/.gradle/
app/build/

# ---- odc_agent (on-device compiled agent = clona net.sys32.odc_agent) ----
# aceeasi politica: stdlib CPython regenerabil EXCLUS, site-packages PASTRAT
odc_agent/app/src/main/assets/python/Lib/*
!odc_agent/app/src/main/assets/python/Lib/site-packages/
!odc_agent/app/src/main/assets/python/Lib/zipfile/
odc_agent/app/src/main/assets/python/libdynload/
odc_agent/gradle/wrapper/gradle-wrapper.jar
odc_agent/gradlew
odc_agent/gradlew.bat
odc_agent/app/build/

# ---- odc_agent e GENERAT din sursa canonica: tools/make_agent_variant.sh ----
# fisierele mari (toolchain nativ, libs native, uneltele de build) NU se comit,
# exact ca la agentul principal - pe device sunt in filesDir/odcassets, nu in git
odc_agent/app/src/main/assets/toolchain/
odc_agent/app/src/main/assets/android_build/
odc_agent/app/src/main/jniLibs/
