<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider pentru instalarea APK-urilor construite pe device (action=install).
     Android 7+ interzice file:// catre alte aplicatii, deci instalatorul de sistem primeste
     un content:// prin FileProvider (vezi AndroidBridge.installApk + android_build.install). -->
<paths>
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
    <external-files-path name="ext" path="." />
    <external-path name="sdcard" path="." />
</paths>
